# Copy to .env.local and fill in from your Supabase project settings.
# Both values are safe to expose: the anon key is public by design, and RLS
# plus the SECURITY DEFINER functions are what actually enforce access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional stable product API endpoint. Defaults to
# NEXT_PUBLIC_SUPABASE_URL/functions/v1/api.
# NEXT_PUBLIC_API_URL=https://api.inferspool.example

# GitHub Pages project path, used only for a project-site production build.
# Local development should leave this unset.
# NEXT_PUBLIC_BASE_PATH=/inferspool
