# inferspool account. INFERSPOOL_URL is optional for the official service.
# INFERSPOOL_URL=https://your-inferspool-server.example
INFERSPOOL_WORKER_ID=home-4090
INFERSPOOL_WORKER_TOKEN=the-worker-token-from-your-inferspool-admin

# Local inference backends — set only the ones you actually run. Each is probed
# independently, so a backend that is down blocks only its own job type.
INFERSPOOL_LLM_URL=http://127.0.0.1:8000       # vLLM / SGLang / llama.cpp / TGI
INFERSPOOL_IMAGE_URL=http://127.0.0.1:8091     # vLLM-Omni image server
# INFERSPOOL_VIDEO_URL=http://127.0.0.1:8092   # vLLM-Omni video server
# INFERSPOOL_TTS_URL=http://127.0.0.1:8093     # vLLM-Omni speech server

# Concurrent jobs each backend accepts. Keep image/video at 1 unless the local
# Omni deployment is explicitly configured for more concurrent generations.
# INFERSPOOL_LLM_CAPACITY=8
# INFERSPOOL_IMAGE_CAPACITY=1
# INFERSPOOL_VIDEO_CAPACITY=1
# INFERSPOOL_TTS_CAPACITY=2

# TTS means text-to-speech and uses vLLM-Omni's /v1/audio/speech endpoint.

# --- 按需拉起（可选） -----------------------------------------------------
# 给某个类型配一条启动命令，它平时就停着，等有对应任务才拉起。全部留空则
# worker 只探活，后端由你自己管理。
#
# INFERSPOOL_IMAGE_LAUNCH='vllm serve /path/to/image-model --omni --port 8091'
# INFERSPOOL_IMAGE_IDLE_TIMEOUT=600     # 空闲 10 分钟后停；0 表示常驻
# INFERSPOOL_IMAGE_READY_TIMEOUT=600    # 这么久还没就绪就算失败
# INFERSPOOL_IMAGE_WARMUP_SECS=5        # 拉起后先等几秒再探活
# INFERSPOOL_IMAGE_CWD=/opt/ComfyUI
#
# INFERSPOOL_LLM_LAUNCH='vllm serve /path/to/model --port 8000'
# INFERSPOOL_LLM_READY_TIMEOUT=900      # 大模型加载慢，给足时间
#
# 用外部进程管理器时必须配 STOP：要停的不是 LAUNCH 启动的那个 shell。
# INFERSPOOL_LLM_LAUNCH='docker start -a my-vllm'
# INFERSPOOL_LLM_STOP='docker stop my-vllm'
#
# 消费级单卡装不下两个大模型，所以默认拉起一个受管后端会先停掉另一个。
# 显存宽裕就设 0。
# INFERSPOOL_EXCLUSIVE_GPU=1
# INFERSPOOL_STOP_GRACE_SECS=30         # SIGTERM -> 等待 -> SIGKILL

# 调优。共享 heartbeat 独立于 handler 运行；handler 在可中断点检查取消。
# INFERSPOOL_LEASE_SECS=120
# INFERSPOOL_HEARTBEAT_SECS=40
# INFERSPOOL_IDLE_POLL_SECS=3.0
# INFERSPOOL_REPORT_SECS=20
# INFERSPOOL_REQUEST_TIMEOUT=1800
# INFERSPOOL_LOG_LEVEL=INFO
